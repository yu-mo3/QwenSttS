{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "▶ 启动阿源（界面）",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app/ui/app.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": false
    },
    {
      "name": "🖼️ 界面（不启动语音会话）",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app/ui/app.py",
      "args": [
        "--no-session",
        "-v"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe"
    },
    {
      "name": "▶ 启动阿源",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app/main.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": false
    },
    {
      "name": "🔍 环境自检",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tools/check_env.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "justMyCode": false
    },
    {
      "name": "🔇 环境自检（跳过录音）",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tools/check_env.py",
      "args": [
        "--no-record"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe"
    },
    {
      "name": "🎧 只看音频设备",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app/main.py",
      "args": [
        "--devices"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe"
    },
    {
      "name": "🎙️ 录音采样（唤醒词验证）",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tools/record_sample.py",
      "args": [
        "--label",
        "ayuan",
        "--count",
        "5"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe"
    },
    {
      "name": "🗣️ 阿源（免按钮对话）",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tools/m3_assistant.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe"
    },
    {
      "name": "🔔 唤醒词验证",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tools/wake_test.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe"
    },
    {
      "name": "⬇️ 下载唤醒模型",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tools/download_models.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "--check"
      ]
    },
    {
      "name": "💬 M2 语音对话（单轮）",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tools/m2_chat.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe"
    }
  ]
}