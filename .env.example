# ============================================================
#  QwenSttS · 环境变量模板
#  用法：复制本文件为 .env，填入真实密钥。
#  ⚠️ .env 已被 .gitignore 忽略，永远不会进入仓库。
# ============================================================

# ---------- 阿里云百炼（DashScope）----------
# 获取：https://bailian.console.aliyun.com/  →  API-KEY 管理
DASHSCOPE_API_KEY=

# ---------- 心知天气 ----------
# 获取：https://www.seniverse.com/  →  控制台
# 注意：本项目使用「私钥」直连（公钥方式在本项目实测返回 403）
WEATHER_API_KEY=

# ---------- 以下为可选项，留空即使用默认值 ----------

# 模型覆盖（不填则使用代码内置默认值）
AYUAN_LLM=
AYUAN_ASR_MODEL=
AYUAN_TTS_MODEL=
AYUAN_TTS_VOICE=
AYUAN_VLM_MODEL=

# 音频设备关键字（用于在多设备环境下精确选中，留空=系统默认）
# 例：AYUAN_INPUT_DEVICE=麦克风阵列
AYUAN_INPUT_DEVICE=
AYUAN_OUTPUT_DEVICE=

# 日志级别：DEBUG / INFO / WARNING
AYUAN_LOG_LEVEL=INFO
